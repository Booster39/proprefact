# Copier ce fichier en .env (dans ce dossier) et remplir chaque valeur.
# Le fichier .env contient des secrets : il est ignoré par git, ne le commitez jamais.

# Base de données
DB_USER=proprefact
DB_PASSWORD=

# Secret de signature des jetons de connexion : 32 caractères minimum, aléatoire.
# Par exemple : openssl rand -hex 32
JWT_SECRET=

# Adresse publique de l'application, utilisée dans les liens envoyés par e-mail (sans / final).
APP_URL=https://factures.exemple.fr

# Serveur d'envoi des e-mails. Sans MAIL_HOST, les e-mails (dont les liens de confirmation)
# sont seulement écrits dans le journal du back-end : à ne jamais laisser ainsi en production.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_EXPEDITEUR=no-reply@exemple.fr

# Port HTTP publié sur la machine (8080 par défaut). L'application et l'API sont à la même adresse.
PORT_HTTP=8080

# Seulement si un proxy HTTPS est placé devant : en-tête où CE proxy écrit l'adresse IP du client.
# Laisser vide sinon (jamais X-Forwarded-For).
ENTETE_IP_CLIENT=
